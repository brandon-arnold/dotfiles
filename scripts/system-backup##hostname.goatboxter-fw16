#!/bin/bash

#####################################################
##
## system-backup
## 
## This script takes a live backup of the `goatboxter-fw16` Framework Laptop 16
##   layout and filesystems. 
##
## The script is also a README about how to restore, assumedly from the Arch
##   Linux installation media. See sections below on commands to restore partition
##   tables, LVM layout, and files (which includes filesystems and block IDs).
##   Afterwards, chroot in and run `mkinitcpio`.
##
#####################################################

BACKUP_ROOT_PATH="/mnt/backup/"
DAYS_BETWEEN_BACKUPS=6
# A local set is kept until the NAS has a copy (system-backup-nas-sync marks it
# with a .synced file). Age is only a backstop for sets that never get synced.
MAX_BACKUP_AGE_DAYS=30
# Free space required before writing a set: newest complete set's size x this.
SPACE_MARGIN_PERCENT=120
# A backup set directory as this script names it (see TIMESTAMP below).
SET_NAME_RE='^[0-9]{8}-[0-9]{2}h[0-9]{2}$'

OPENCLAW='/home/brandon/.npm-packages/bin/openclaw'
CHANNEL='1483997048414933106'  # Discord #openclaw-fw16

# Notify Discord #openclaw-fw16 on backup failure.
# Pattern: logger first (survives Discord being down), then openclaw.
# Never fails -- Discord outage must not hide the journal record.
notify() {
    local MSG="[$(hostname) system-backup] $1"
    logger -t system-backup -p daemon.crit -- "${MSG}"
    # systemd runs as root; openclaw needs brandon's gateway context.
    runuser -u brandon -- env HOME=/home/brandon \
        "${OPENCLAW}" message send --channel discord \
        --target "channel:${CHANNEL}" --message "${MSG}" \
        >/dev/null 2>&1 \
        || logger -t system-backup -p daemon.err -- \
           "Discord notify FAILED for: ${MSG}"
}

cleanup() {
    # Re-mount /boot if we unmounted it
    if [ "${UNMOUNTED_BOOT:-0}" -eq 1 ] && ! mountpoint -q /boot; then
        mount /boot
    fi
    # Remove any leftover snapshots
    TRY_SILENT=1 VOLGROP='fw16-vg' SNAPVOL='arch-root-backup-snap' /home/brandon/scripts/snap-lvm-delete
    TRY_SILENT=1 VOLGROP='fw16-vg' SNAPVOL='arch-home-backup-snap' /home/brandon/scripts/snap-lvm-delete
    TRY_SILENT=1 VOLGROP='fw16-vg' SNAPVOL='arch-vm2-backup-snap' /home/brandon/scripts/snap-lvm-delete
}
# ONE EXIT handler: cleanup ALWAYS runs (remount /boot + delete leftover LVM
# snapshots), then notify on any non-zero exit. Capture $? FIRST -- it's the
# true exit status, so notify fires on the `exit 1` hard-fail paths (where RES
# is still 0) and on a signal-kill, while the skip paths (exit 0: not enough
# time elapsed) stay silent.
on_exit() {
    local rc=$?
    cleanup
    [ "${rc}" -ne 0 ] && notify "Image backup FAILED (exit code ${rc})${FAIL_REASON:+: ${FAIL_REASON}}"
    return "${rc}"
}
trap on_exit EXIT

#####################################################
##
## Check if enough time has elapsed since last backup
##
#####################################################

echo "system-backup on "$(date)

SECONDS_BETWEEN_BACKUPS=$((DAYS_BETWEEN_BACKUPS * 24 * 60 * 60))

if ! /home/brandon/scripts/touch-date-check \
     -f "${BACKUP_ROOT_PATH}backuptime.txt" \
     -s "${SECONDS_BETWEEN_BACKUPS}"
then
    echo "Canceling, as not enough time has elapsed since last backup."
    exit 0
fi

#####################################################
##
## Prune local backup sets
##
## A set lives on this volume so that system-backup-nas-sync can copy it to the
## NAS, which may be unreachable for days. So a set is deleted only once the NAS
## has it (.synced marker, written by the sync script), oldest first, and only
## as far as needed to make room for the set about to be written. The newest
## complete set always stays as a local restore source. Incomplete sets left by
## failed runs (no COMPLETE marker) are deleted outright. Complete sets older
## than MAX_BACKUP_AGE_DAYS are deleted even if never synced.
##
## Directories that don't match SET_NAME_RE (hand-made folders) are left alone.
##
#####################################################

# Complete sets, oldest first (the names sort chronologically).
list_sets() {
    local d
    for d in "${BACKUP_ROOT_PATH}"20*/; do
        d=$(basename "${d}")
        [[ "${d}" =~ ${SET_NAME_RE} ]] || continue
        [ -e "${BACKUP_ROOT_PATH}${d}/COMPLETE" ] && echo "${d}"
    done
}

free_bytes() {
    df --output=avail -B1 "${BACKUP_ROOT_PATH}" | tail -n 1
}

# Incomplete sets from failed runs
for d in "${BACKUP_ROOT_PATH}"20*/; do
    d=$(basename "${d}")
    [[ "${d}" =~ ${SET_NAME_RE} ]] || continue
    if [ ! -e "${BACKUP_ROOT_PATH}${d}/COMPLETE" ]; then
        echo "removing incomplete set ${d}"
        rm -rf "${BACKUP_ROOT_PATH:?}${d}"
    fi
done

NEWEST=$(list_sets | tail -n 1)

# Age backstop; never the newest set
for d in $(list_sets); do
    [ "${d}" = "${NEWEST}" ] && continue
    if [ -n "$(find "${BACKUP_ROOT_PATH}${d}/COMPLETE" -mtime "+${MAX_BACKUP_AGE_DAYS}")" ]; then
        echo "removing set ${d}: older than ${MAX_BACKUP_AGE_DAYS} days"
        rm -rf "${BACKUP_ROOT_PATH:?}${d}"
    fi
done

# Make room: synced sets, oldest first, until the newest set's size plus margin fits
if [ -n "${NEWEST}" ]; then
    NEEDED=$(( $(du -sb "${BACKUP_ROOT_PATH}${NEWEST}" | cut -f1) * SPACE_MARGIN_PERCENT / 100 ))
    for d in $(list_sets); do
        [ "$(free_bytes)" -ge "${NEEDED}" ] && break
        [ "${d}" = "${NEWEST}" ] && continue
        if [ -e "${BACKUP_ROOT_PATH}${d}/.synced" ]; then
            echo "removing synced set ${d} to make room"
            rm -rf "${BACKUP_ROOT_PATH:?}${d}"
        else
            echo "keeping ${d}: not on the NAS yet"
        fi
    done
    if [ "$(free_bytes)" -lt "${NEEDED}" ]; then
        FAIL_REASON="need $(( NEEDED / 1024 / 1024 / 1024 )) GiB free on ${BACKUP_ROOT_PATH}, have $(( $(free_bytes) / 1024 / 1024 / 1024 )) GiB, and the remaining sets are not on the NAS yet"
        echo "${FAIL_REASON}"
        exit 1
    fi
fi

#####################################################
##
## Init backup params and path
##
#####################################################
TIMESTAMP="$(date +%Y%m%d-%Hh%M)"
BACKDIR="${BACKUP_ROOT_PATH}${TIMESTAMP}"
RES=0 # returned by this script to indicate any errors
mkdir ${BACKDIR}

#####################################################
##
## Include the current version of this backup script for documentation
##
#####################################################

cp $(readlink -f "$0") "${BACKDIR}/README"

#####################################################
##
## Back up partition table(s), LVM metadata, and block (filesystem) UUIDs
##
## --
##
## For restoration, use `sfdisk` to restore the partition tables, `pvcreate` and
##     `vgcfgrestore` to restore LVM, and `fsarchiver` to restore the filesystems.
##
## Note on UUIDs: there are partition UUIDs (PARTUUIDs), LVM UUIDs, and filesystem UUIDs.
##
##   - Partition UUIDs will be important for the EFI NVRAM to find the rEFInd boot
##     partition and for the boot loader to find the swap and LVM partitions.
##     The easiest restore path is `sfdisk`, which preserves PARTUUIDs from the
##     dump automatically. Alternatively, use gdisk(8) to set PARTUUIDs on a new
##     system to match, or `efibootmgr` to update the NVRAM entry to point at the
##     new PARTUUID. Run mkinitcpio on the restored system regardless (to match
##     new hardware).
##   - LVM UUIDs should match, too, which will be referenced by LVM itself and
##     possibly other systems backed up in the root and home volumes. After
##     creating the LVM physical volumes with `pvcreate`, use
##     vgcfgrestore -f /path/to/etc-lvm-backup VOLUME_GROUP_NAME
##     to restore VG, LV, and PV UUIDs from the metadata.
##   - Block/filesystem UUIDs will be important for the kernel to automount from
##     the /etc/fstab entry. `fsarchiver` is used to back up filesystems,
##     and its corresponding restoration should bring back the block UUIDs for
##     free. If you need to do it manually, use tune2fs(8) -U for ext4 or
##     mlabel(1) for FAT, or do the reverse by updating /etc/fstab to the new
##     UUIDs.
##   - Swap UUID is referenced in /etc/fstab but is not captured by fsarchiver.
##     On restore, use `mkswap -U <original-uuid>` (extract from blkid.txt).
##
## See inline comments on which steps back up each UUID type.
##
#####################################################

# includes PARTUUIDs
sfdisk -d /dev/disk/by-id/nvme-eui.e8238fa6bf530001001b448b4f0bf183 > "${BACKDIR}/sfdisk-partition-table__dev--disk--by-id--nvme-eui.e8238fa6bf530001001b448b4f0bf183.txt"
sfdisk -d /dev/disk/by-id/nvme-eui.e8238fa6bf530001001b444a45813fb2 > "${BACKDIR}/sfdisk-partition-table__dev--disk--by-id--nvme-eui.e8238fa6bf530001001b444a45813fb2.txt"

# includes LVM UUIDs
cp /etc/lvm/backup/fw16-vg "${BACKDIR}/etc-lvm-backup-fw16-vg"
cp /etc/lvm/backup/fw16-2-vg "${BACKDIR}/etc-lvm-backup-fw16-2-vg"

# includes filesystem UUIDs
blkid > "${BACKDIR}/blkid.txt"

#####################################################
##
## Back up NVRAM
##
#####################################################

efibootmgr -v > "${BACKDIR}/efibootmgr.txt"

#####################################################
##
## Back up /boot
##
## --
##
## When restoring, use `fsarchiver` pointed at the new primary partition
##
#####################################################

echo "backing up /boot: "$(date)

if mountpoint -q /boot; then
    if ! umount /boot
    then
        echo "unable to unmount /boot"
        exit 1
    fi
    UNMOUNTED_BOOT=1
fi

if ! fsarchiver savefs -Z8 -j8 "${BACKDIR}/boot.fsa" /dev/disk/by-uuid/5F7D-3EB0
then
    echo "fsarchive exited with a fail status on /boot"
    RES=1
fi

if [ "${UNMOUNTED_BOOT:-0}" -eq 1 ]; then
    if ! mount /boot; then
        echo "unable to mount /boot"
        exit 1
    fi
    UNMOUNTED_BOOT=0
fi

(cd "${BACKDIR}" && sha256sum boot.fsa > boot.fsa.sha256)

#####################################################
##
## Back up /dev/fw16-vg/arch-root
##
## --
##
## When restoring, use `fsarchiver` pointed at the new logical volume
##
#####################################################

echo "backing up arch-root: "$(date)

TRY_SILENT=1 VOLGROP='fw16-vg' SNAPVOL='arch-root-backup-snap' /home/brandon/scripts/snap-lvm-delete

if ! VOLGROP='fw16-vg' ORIGVOL='arch-root' SNAPVOL='arch-root-backup-snap' SNAPSIZ='40G' /home/brandon/scripts/snap-lvm
then
    echo "unable to snap arch-root"
    exit 1
fi

if ! FSAOPTS='-Z8 -j8' VOLGROP='fw16-vg' SNAPVOL='arch-root-backup-snap' BACKDIR="${BACKDIR}" BACKNAM='arch-root' /home/brandon/scripts/snap-lvm-fsarchive
then
    echo "fsarchive exited with a fail status on arch-root"
    RES=1
fi

VOLGROP='fw16-vg' SNAPVOL='arch-root-backup-snap' /home/brandon/scripts/snap-lvm-delete

(cd "${BACKDIR}" && sha256sum arch-root.fsa > arch-root.fsa.sha256)

#####################################################
##
## Back up /dev/fw16-vg/arch-home
##
## --
##
## When restoring, use `fsarchiver` pointed at the new logical volume
##
#####################################################

echo "backing up arch-home: "$(date)

TRY_SILENT=1 VOLGROP='fw16-vg' SNAPVOL='arch-home-backup-snap' /home/brandon/scripts/snap-lvm-delete

if ! VOLGROP='fw16-vg' ORIGVOL='arch-home' SNAPVOL='arch-home-backup-snap' SNAPSIZ='40G' /home/brandon/scripts/snap-lvm
then
    echo "unable to snap arch-home"
    exit 1
fi

if ! FSAOPTS='-Z8 -j8' VOLGROP='fw16-vg' SNAPVOL='arch-home-backup-snap' BACKDIR="${BACKDIR}" BACKNAM='arch-home' /home/brandon/scripts/snap-lvm-fsarchive
then
    echo "fsarchive exited with a fail status on arch-home"
    RES=1
fi

VOLGROP='fw16-vg' SNAPVOL='arch-home-backup-snap' /home/brandon/scripts/snap-lvm-delete

(cd "${BACKDIR}" && sha256sum arch-home.fsa > arch-home.fsa.sha256)

#####################################################
##
## Back up /dev/fw16-vg/arch-vm2
##
## --
##
## When restoring, use `fsarchiver` pointed at the new logical volume
##
#####################################################

echo "backing up arch-vm2: "$(date)

TRY_SILENT=1 VOLGROP='fw16-vg' SNAPVOL='arch-vm2-backup-snap' /home/brandon/scripts/snap-lvm-delete

if ! VOLGROP='fw16-vg' ORIGVOL='arch-vm2' SNAPVOL='arch-vm2-backup-snap' SNAPSIZ='40G' /home/brandon/scripts/snap-lvm
then
    echo "unable to snap arch-vm2"
    exit 1
fi

if ! FSAOPTS='-Z8 -j8' VOLGROP='fw16-vg' SNAPVOL='arch-vm2-backup-snap' BACKDIR="${BACKDIR}" BACKNAM='arch-vm2' /home/brandon/scripts/snap-lvm-fsarchive
then
    echo "fsarchive exited with a fail status on arch-vm2"
    RES=1
fi

VOLGROP='fw16-vg' SNAPVOL='arch-vm2-backup-snap' /home/brandon/scripts/snap-lvm-delete

(cd "${BACKDIR}" && sha256sum arch-vm2.fsa > arch-vm2.fsa.sha256)


#####################################################
##
## Mark the set complete and update backuptime
##
## COMPLETE tells system-backup-nas-sync the set may be copied, and tells the
## prune step above that the set is a candidate to keep.
##
#####################################################

if [[ ${RES} -lt 1 ]]
then
    date > "${BACKDIR}/COMPLETE"
    date +%s > "${BACKUP_ROOT_PATH}backuptime.txt"
else
    echo "error with backup; exiting without updating backuptime: "$(date)
    exit ${RES}
fi

echo "finished: "$(date)

exit ${RES}
