# KVM switched back to this machine: its USB hub (Realtek RTS5411) re-appears.
# Ask the user's systemd to run kvm-return.service, which re-modesets the Dells.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{idProduct}=="5411", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}="kvm-return.service"
