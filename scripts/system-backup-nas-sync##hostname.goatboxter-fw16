#!/bin/bash

#####################################################
##
## system-backup-nas-sync
##
## Syncs local system image backups from /mnt/backup/ to the NAS
## via rsync over SSH (bkp9700@truenas.bant).
##
## Designed to be run on a timer independently from system-backup.
## Tolerates the NAS being offline (exits cleanly).
##
#####################################################

LOCAL_BACKUP_PATH="/mnt/backup/"
NAS_HOST="bkp9700@truenas.bant"
NAS_BACKUP_PATH="/mnt/tank/backups/images/goatboxter-fw16/"
MAX_NAS_BACKUPS=26

OPENCLAW='/home/brandon/.npm-packages/bin/openclaw'
CHANNEL='1483997048414933106'  # Discord #openclaw-fw16

# Notify Discord #openclaw-fw16 on sync failure.
# Pattern: logger first (survives Discord being down), then openclaw.
# Never fails -- Discord outage must not hide the journal record.
notify() {
    local MSG="[$(hostname) system-backup-nas-sync] $1"
    logger -t system-backup-nas-sync -p daemon.crit -- "${MSG}"
    # systemd runs as root; openclaw needs brandon's gateway context.
    runuser -u brandon -- env HOME=/home/brandon \
        "${OPENCLAW}" message send --channel discord \
        --target "channel:${CHANNEL}" --message "${MSG}" \
        >/dev/null 2>&1 \
        || logger -t system-backup-nas-sync -p daemon.err -- \
           "Discord notify FAILED for: ${MSG}"
}

# EXIT handler: notify on any non-zero exit. No local cleanup is needed (this
# script mounts/snapshots nothing). Capture $? FIRST so notify fires on the
# `exit 1` failure paths (local path missing, rsync hard-fail); the
# NAS-unreachable path exits 0 by design and stays silent.
on_exit() {
    local rc=$?
    [ "${rc}" -ne 0 ] && notify "Backup NAS sync FAILED (exit code ${rc})"
    return "${rc}"
}
trap on_exit EXIT

echo "system-backup-nas-sync on $(date)"

#####################################################
##
## Check that the NAS is reachable via SSH
##
#####################################################

if ! ssh -o ConnectTimeout=10 -o BatchMode=yes "${NAS_HOST}" true 2>/dev/null; then
    echo "NAS is not reachable via SSH (${NAS_HOST}), skipping sync"
    exit 0
fi

#####################################################
##
## Check that local backup path exists
##
#####################################################

if [ ! -d "${LOCAL_BACKUP_PATH}" ]; then
    echo "Local backup path ${LOCAL_BACKUP_PATH} does not exist"
    exit 1
fi

#####################################################
##
## Sync backup directories to NAS
##
## - Only syncs timestamped backup dirs (20*)
## - Partial transfers are resumable via --partial
##
#####################################################

rsync -rltv --omit-dir-times --partial --bwlimit=40m \
    --include='20*/' \
    --include='20*/**' \
    --exclude='*' \
    -e "ssh -o BatchMode=yes -o ServerAliveInterval=10 -o ServerAliveCountMax=3" \
    "${LOCAL_BACKUP_PATH}" "${NAS_HOST}:${NAS_BACKUP_PATH}"

RSYNC_EXIT=$?

if [ ${RSYNC_EXIT} -eq 23 ]; then
    echo "rsync completed with warnings (code 23, likely permission issues on existing files): $(date)"
elif [ ${RSYNC_EXIT} -ne 0 ]; then
    echo "rsync failed with exit code ${RSYNC_EXIT}: $(date)"
    exit 1
fi

#####################################################
##
## Delete oldest NAS backups beyond MAX_NAS_BACKUPS
##
#####################################################

NAS_DIRS=$(ssh -o BatchMode=yes "${NAS_HOST}" \
    "find '${NAS_BACKUP_PATH}' -maxdepth 1 -type d -name '20*' -printf '%f\n'" | sort)
NAS_COUNT=$(echo "${NAS_DIRS}" | grep -c .)

if [ "${NAS_COUNT}" -gt "${MAX_NAS_BACKUPS}" ]; then
    DELETE_COUNT=$(( NAS_COUNT - MAX_NAS_BACKUPS ))
    echo "Found ${NAS_COUNT} backups on NAS, removing ${DELETE_COUNT} oldest"
    echo "${NAS_DIRS}" | head -n ${DELETE_COUNT} | while read -r DIR; do
        echo "Deleting ${NAS_BACKUP_PATH}${DIR}"
        ssh -o BatchMode=yes "${NAS_HOST}" "rm -rf '${NAS_BACKUP_PATH}${DIR}'"
    done
else
    echo "Found ${NAS_COUNT} backups on NAS, within limit of ${MAX_NAS_BACKUPS}"
fi

echo "finished: $(date)"
exit 0
